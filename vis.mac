# vis.mac - visualizzazione di nucleo e citoplasma con le tracce del decadimento di Cu-64
# Volumi logici dal tuo DetectorConstruction: World_LV, Nucl_LV (r = 4 um), Cyto_LV (guscio 4-5 um)
# Viene caricato da init_vis.mac (che dopo /run/initialize chiama /control/execute vis.mac)

/control/verbose 2
/run/verbose 1
/tracking/verbose 0

# Driver grafico: OGL usa Qt se disponibile, altrimenti X11
/vis/open OGL 900x900-0+0
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Geometria: il mondo (acqua, 1 mm) va nascosto, altrimenti copre tutto
/vis/drawVolume
/vis/geometry/set/visibility World_LV 0 false
/vis/geometry/set/visibility Nucl_LV 0 true
/vis/geometry/set/visibility Cyto_LV 0 true
/vis/geometry/set/colour Nucl_LV 0 1.0 0.6 0.1 0.35
/vis/geometry/set/colour Cyto_LV 0 0.2 0.6 1.0 0.15
/vis/geometry/set/forceSolid Nucl_LV 0 true
/vis/geometry/set/forceSolid Cyto_LV 0 true

# Vista
/vis/viewer/set/viewpointVector -1 0.7 0.5
/vis/viewer/set/lightsVector 1 1 1
/vis/viewer/set/style surface
/vis/viewer/set/background white
/vis/viewer/set/lineSegmentsPerCircle 100

# Traiettorie colorate per particella, con punti di step (sono le hit del tuo TrackerSD)
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/default/setLineWidth 2
/vis/modeling/trajectories/drawByParticleID-0/set e- blue
/vis/modeling/trajectories/drawByParticleID-0/set e+ red
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByParticleID-0/default/setStepPtsSize 3
/vis/modeling/trajectories/select drawByParticleID-0

# Se TrackerHit non ha un metodo Draw() questo comando non disegna nulla, ma non da errore
/vis/scene/add/hits

# Accumula gli eventi nella stessa immagine (fino a 100)
/vis/scene/endOfEventAction accumulate 100

# Assi e scala in micron
/vis/scene/add/axes 0 0 0 6 um
/vis/scene/add/scale 2 um

# Zoom sulla cellula (il mondo e 2 mm, la cellula 10 um: serve zoom alto)
/vis/viewer/zoomTo 150
/vis/viewer/set/autoRefresh true
/vis/verbose warnings

# --- Per salvare uno screenshot dopo /run/beamOn 5 ---
# /vis/ogl/set/exportFormat png
# /vis/ogl/export cellula_eventi.png
