# init_vis.mac - sessione interattiva con la STESSA configurazione di microyz.in
# (fisica, geometria, sorgente Cu-64), ma senza /run/beamOn: gli eventi li lanci tu dalla finestra.
#
/control/verbose 2
/control/saveHistory
/run/verbose 2
#
# MT mode (pochi thread bastano per la visualizzazione)
/run/numberOfThreads 4
#
# Atomic deexcitation activation
/process/em/deexcitationIgnoreCut true
/process/em/fluo true
/process/em/pixe true
/process/em/auger true
/process/em/augerCascade true
#
# Physics
/microyz/phys/addPhysics dna_opt4
/microyz/phys/addPhysics RadioactiveDecayPhysics
#
# Sphere radius, nucleus and cytoplasm
/microyz/det/Radius 420 nm
/microyz/det/setNuclRadius 4 um
/microyz/det/setCytoThickness 1 um
/microyz/det/setHalfWorldSize 5 mm
#
/run/initialize
#
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/process/had/rdm/verbose 1
#
# Activation of atomic deexcitation
/process/em/fluo true
/process/em/auger true
/process/em/augerCascade true
/process/em/pixe true
/process/em/deexcitationIgnoreCut true
#
# Cu 64
/gun/particle ion
/gun/ion 29 64 0
/gun/energy 0 eV
#
# Visualization setting
/control/execute vis.mac
#
# Poi, dalla finestra: /run/beamOn 3
